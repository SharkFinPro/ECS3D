<Project>
    <PropertyGroup>
        <!-- The extra "ScriptBridge/" segment (absent from Transport's own Directory.Build.props) matters
             only when this project is built as a ProjectReference under someone else's BuildRoot, as
             ECS3DManagedTests does: without it, this path collapses to the literal $(BuildRoot)obj/ that
             Transport's own Directory.Build.props also uses, so referencing both from one project under
             one shared BuildRoot would point their generated obj output at the same directory - the
             CS0579 trap ECS3DManagedTests/Directory.Build.props already describes for the test project
             itself. ecs3d_add_managed_assembly's own standalone publish is unaffected: it overrides
             BaseIntermediateOutputPath via the DOTNET_BASE_INTERMEDIATE_OUTPUT_PATH-conditioned property
             in ScriptBridge.csproj, which wins over this fallback. -->
        <BaseIntermediateOutputPath>$(BuildRoot)obj/ScriptBridge/</BaseIntermediateOutputPath>
    </PropertyGroup>
</Project>