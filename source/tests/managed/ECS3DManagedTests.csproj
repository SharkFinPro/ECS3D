<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>ECS3DManagedTests</RootNamespace>
        <AssemblyName>ECS3DManagedTests</AssemblyName>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <!-- BridgeNativeBindingsLayoutTests takes sizeof() of ScriptBridge's *Bindings structs, which are
             blocks of delegate* unmanaged<...> function pointers - an unsafe context is needed to size
             them the same way ScriptBridge itself does. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The linked launcher dialogs load through AvaloniaXamlLoader like the launcher's own views, so the
             name generator (which needs a partial class) is pointed at a namespace nothing lives in. -->
        <AvaloniaNameGeneratorFilterByNamespace>ECS3DLauncher.NoGeneratedViews</AvaloniaNameGeneratorFilterByNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
        <PackageReference Include="Avalonia" Version="12.0.5" />
        <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    </ItemGroup>

    <!-- Both assemblies have pure, testable logic that does not need their native host wired up: Transport's
         wire framing/handshake, and ScriptBridge's [ExposeToEditor] field reflection/JSON and value
         conversion and, through FakeNatives, the Transform/RigidBody/Camera/etc. wrappers; the
         [UnmanagedCallersOnly] entry points are called through function pointers. A plain ProjectReference is
         safe for both rather than compiling files in by Link: the BuildRoot isolation in Directory.Build.props
         (this directory) keeps this project's own build output separate from theirs, and ScriptBridge's own
         Directory.Build.props gives it a "ScriptBridge/" obj subfolder so its output does not collide with
         Transport's when both are referenced under this project's shared BuildRoot. -->
    <ItemGroup>
        <ProjectReference Include="../../libs/net/Transport/ECS3DNetTransport.csproj" />
        <ProjectReference Include="../../libs/scripting/ScriptBridge/ScriptBridge.csproj" />
    </ItemGroup>

    <!-- The user and starter scripts are plain C# over ScriptBridge, so they compile into this assembly and are
         tested through FakeNatives like the wrappers. The CMake copy that ships them is unaffected. -->
    <ItemGroup>
        <Compile Include="../../libs/scripting/UserScripts/**/*.cs"
                 Link="UserScripts/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Coin Rush's own scripts, so its ScorePillar is tested like the starters. -->
    <ItemGroup>
        <Compile Include="../../templates/coin-rush/scripts/**/*.cs"
                 Link="CoinRush/Scripts/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- The launcher is an Avalonia WinExe, so it is not referenced. Its services, view models, models and the
         XAML-free CardMenu helper compile into this assembly by link, over the two UI packages above. The New
         Project dialog compiles in with its XAML so a headless test drives the real bindings; its theme
         resources are supplied by the test. The window, other views and DesignData stay out: DesignData builds
         the real default view model against the user data folder. -->
    <ItemGroup>
        <Compile Include="../../apps/launcher/source/Services/**/*.cs"
                 Link="Launcher/Services/%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="../../apps/launcher/source/Shell/*ViewModel.cs"
                 Link="Launcher/Shell/%(Filename)%(Extension)" />
        <Compile Include="../../apps/launcher/source/Tabs/**/*ViewModel.cs"
                 Link="Launcher/Tabs/%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="../../apps/launcher/source/Shared/Models/*.cs"
                 Link="Launcher/Shared/Models/%(Filename)%(Extension)" />
        <Compile Include="../../apps/launcher/source/Shared/Converters/*.cs"
                 Link="Launcher/Shared/Converters/%(Filename)%(Extension)" />
        <Compile Include="../../apps/launcher/source/Shared/Controls/CardMenu.cs"
                 Link="Launcher/Shared/Controls/%(Filename)%(Extension)" />
        <Compile Include="../../apps/launcher/source/Shared/Controls/InvokableMenuItem.cs"
                 Link="Launcher/Shared/Controls/%(Filename)%(Extension)" />
        <Compile Include="../../apps/launcher/source/Tabs/Templates/NewProjectDialog.axaml.cs"
                 Link="Launcher/Tabs/Templates/%(Filename)%(Extension)" />
        <Compile Include="../../apps/launcher/source/Shared/Controls/EmptyState.axaml.cs"
                 Link="Launcher/Shared/Controls/%(Filename)%(Extension)" />
        <AvaloniaXaml Include="../../apps/launcher/source/Shared/Controls/EmptyState.axaml"
                      Link="Launcher/Shared/Controls/%(Filename)%(Extension)" />
        <AvaloniaXaml Include="../../apps/launcher/source/Tabs/Templates/NewProjectDialog.axaml"
                      Link="Launcher/Tabs/Templates/%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- ShippedScriptsCompileTests finds the shipped scripts from the source tree this project lives in. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ECS3DSourceRoot</_Parameter1>
            <_Parameter2>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
