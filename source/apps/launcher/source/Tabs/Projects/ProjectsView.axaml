<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ECS3DLauncher.Shared.Models"
             xmlns:local="using:ECS3DLauncher.Tabs.Projects"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dd="using:ECS3DLauncher.Shared"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="720"
             d:DataContext="{x:Static dd:DesignData.Projects}"
             x:Class="ECS3DLauncher.Tabs.Projects.ProjectsView"
             x:DataType="local:ProjectsViewModel">

    <Panel>

        <!-- PROJECTS: FIRST RUN -->
        <WrapPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Margin="0,40,0,0">
            <Border Width="236" Margin="9" Padding="18" CornerRadius="11"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Explore the engine" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Open the Welcome scene and look around before making anything." FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource T3Brush}" />
                    </StackPanel>
                    <Button Classes="secondary" Theme="{StaticResource BareButton}" Content="Open Welcome scene" HorizontalAlignment="Left"
                            Command="{Binding ExploreCommand}"
                                ToolTip.Tip="{Binding ExploreTooltip}" ToolTip.ShowOnDisabled="True" />
                </StackPanel>
            </Border>
            <Border Width="236" Margin="9" Padding="18" CornerRadius="11"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Start a project" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Begin from a template and make it your own." FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource T3Brush}" />
                    </StackPanel>
                    <Button Classes="cta" Theme="{StaticResource BareButton}" HorizontalAlignment="Left"
                            Command="{Binding NewProjectCommand}">
                            <TextBlock Text="New Project" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource AccText}" VerticalAlignment="Center" />
                        </Button>
                </StackPanel>
            </Border>
            <Border Width="236" Margin="9" Padding="18" CornerRadius="11"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Try a sample" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Open a finished example project and see how it is built." FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource T3Brush}" />
                    </StackPanel>
                    <Button Classes="secondary" Theme="{StaticResource BareButton}" Content="Browse samples" HorizontalAlignment="Left"
                            Command="{Binding BrowseSamplesCommand}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- PROJECTS: NO MATCHES -->
        <TextBlock IsVisible="{Binding ShowNoMatches}" Text="No projects match" FontSize="12.5"
                   Foreground="{StaticResource T3Brush}" HorizontalAlignment="Center" Margin="0,200,0,0" />

        <!-- PROJECTS: GRID -->
        <ItemsControl IsVisible="{Binding ShowGrid}" ItemsSource="{Binding ProjectTiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Margin="-9" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:Project">
                    <Panel Width="236" Height="238" Margin="9">

                        <!-- New Project card -->
                        <Button Classes="card-btn" Theme="{StaticResource BareButton}"
                                IsVisible="{Binding IsNewCard}" CornerRadius="11"
                                Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).NewProjectCommand, FallbackValue={x:Null}}">
                            <Panel>
                                <Rectangle Classes="dash" RadiusX="11" RadiusY="11"
                                           Fill="{StaticResource AccDim}"
                                           Stroke="#661FB8D4" StrokeThickness="1.5" StrokeDashArray="5,4" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11">
                                    <Border Width="46" Height="46" CornerRadius="12" HorizontalAlignment="Center"
                                            Background="{StaticResource AccDim2}">
                                        <Path Classes="icon acc" Width="18" Height="18" StrokeThickness="1.7"
                                              Data="{StaticResource IconPlus}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="New Project" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Start from a template" FontSize="11.5"
                                                   Foreground="{StaticResource AccSubtitle}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Panel>
                        </Button>

                        <!-- Project card -->
                        <Border Classes="card" IsVisible="{Binding IsRealCard}"
                                CornerRadius="11" ClipToBounds="True">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open in editor"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).OpenProjectCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Play"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).PlayProjectCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).PlayTooltip, FallbackValue={x:Null}}"
                                              ToolTip.ShowOnDisabled="True" />
                                    <MenuItem Header="Show in folder"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).ShowInFolderCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Pin to top"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).TogglePinCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}"
                                              IsVisible="{Binding !Pinned}" />
                                    <MenuItem Header="Unpin"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).TogglePinCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}"
                                              IsVisible="{Binding Pinned}" />
                                    <MenuItem Header="Remove from list"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).RemoveProjectCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <!-- thumbnail -->
                                <Panel Height="146" Background="{StaticResource InsetBrush}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           IsVisible="{Binding HasThumbnail}" />
                                    <Panel IsVisible="{Binding !HasThumbnail}">
                                        <Border Background="{StaticResource ThumbStripes}" />
                                        <Border Background="{Binding GlowBrush}" />
                                        <Path Classes="icon" Width="30" Height="30"
                                              Stroke="#2EFFFFFF" StrokeThickness="2.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="{Binding PlaceholderIcon, Converter={StaticResource IconKey}}" />
                                    </Panel>
                                    <Border IsVisible="{Binding IsMissing}" Background="#CC0D0E10">
                                        <TextBlock Text="Folder not found" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border IsVisible="{Binding IsInEditor}" CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"
                                            Background="{StaticResource AccDim2}">
                                        <TextBlock Text="In editor" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccBrush}" />
                                    </Border>
                                    <Border IsVisible="{Binding Pinned}" Width="24" Height="24" CornerRadius="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"
                                            Background="#A60D0E10">
                                        <Path Classes="icon fill" Width="10" Height="10"
                                              Data="{StaticResource IconStar}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Panel>
                                <!-- info -->
                                <StackPanel Margin="14,13,14,14">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="11.5" Margin="0,3,0,0"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               Foreground="{StaticResource T3Brush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,11,0,0" ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Path Grid.Column="0" Classes="icon t3" Width="10" Height="10"
                                              IsVisible="{Binding IsPresent}"
                                              VerticalAlignment="Center" Data="{StaticResource IconClock}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Edited}" FontSize="11.5"
                                                   IsVisible="{Binding IsPresent}"
                                                   Margin="7,0,0,0" Foreground="{StaticResource T2Brush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6"
                                                    IsVisible="{Binding IsMissing}" VerticalAlignment="Center">
                                            <Button Classes="open" Theme="{StaticResource BareButton}" Content="Locate"
                                                    Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).LocateProjectCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="open" Theme="{StaticResource BareButton}" Content="Remove"
                                                    Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).RemoveProjectCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="open" Theme="{StaticResource BareButton}" Content="Open"
                                                IsVisible="{Binding IsPresent}"
                                                ToolTip.Tip="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).OpenTooltip, FallbackValue={x:Null}}"
                                                ToolTip.ShowOnDisabled="True"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).OpenProjectCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Classes="more" Theme="{StaticResource BareButton}" Click="OnMoreClick"
                                                ToolTip.Tip="More" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="..." FontSize="13" FontWeight="Bold" Foreground="{StaticResource T2Brush}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- PROJECTS: LIST -->
        <ItemsControl IsVisible="{Binding ShowList}" ItemsSource="{Binding ProjectTiles}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:Project">
                    <Panel Margin="0,0,0,8">

                        <!-- New Project row -->
                        <Button Classes="card-btn" Theme="{StaticResource BareButton}"
                                IsVisible="{Binding IsNewCard}" CornerRadius="9"
                                Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).NewProjectCommand, FallbackValue={x:Null}}">
                            <Panel>
                                <Rectangle Classes="dash" RadiusX="9" RadiusY="9"
                                           Fill="{StaticResource AccDim}"
                                           Stroke="#661FB8D4" StrokeThickness="1.5" StrokeDashArray="5,4" />
                                <StackPanel Orientation="Horizontal" Spacing="14" Margin="14,11">
                                    <Border Width="38" Height="38" CornerRadius="8"
                                            Background="{StaticResource AccDim2}">
                                        <Path Classes="icon acc" Width="13.5" Height="13.5" StrokeThickness="1.4"
                                              Data="{StaticResource IconPlus}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="New Project" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccBrush}" />
                                        <TextBlock Text="Start from a template" FontSize="11.5"
                                                   Foreground="{StaticResource AccSubtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Panel>
                        </Button>

                        <!-- Project row -->
                        <Border Classes="card row" IsVisible="{Binding IsRealCard}" CornerRadius="9">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open in editor"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).OpenProjectCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Play"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).PlayProjectCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}"
                                              ToolTip.Tip="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).PlayTooltip, FallbackValue={x:Null}}"
                                              ToolTip.ShowOnDisabled="True" />
                                    <MenuItem Header="Show in folder"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).ShowInFolderCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Pin to top"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).TogglePinCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}"
                                              IsVisible="{Binding !Pinned}" />
                                    <MenuItem Header="Unpin"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).TogglePinCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}"
                                              IsVisible="{Binding Pinned}" />
                                    <MenuItem Header="Remove from list"
                                              Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).RemoveProjectCommand, FallbackValue={x:Null}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="14,9">
                                <Border Grid.Column="0" Width="60" Height="38" CornerRadius="6"
                                        ClipToBounds="True" Background="{StaticResource InsetBrush}">
                                    <Panel>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               IsVisible="{Binding HasThumbnail}" />
                                        <Border Background="{StaticResource ThumbStripes}"
                                                IsVisible="{Binding !HasThumbnail}" />
                                        <Border Background="{Binding GlowBrush}"
                                                IsVisible="{Binding !HasThumbnail}" />
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border IsVisible="{Binding IsInEditor}" CornerRadius="6" Padding="8,2"
                                                VerticalAlignment="Center" Background="{StaticResource AccDim2}">
                                            <TextBlock Text="In editor" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" FontSize="11.5"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               Foreground="{StaticResource T3Brush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Panel Grid.Column="2" Width="110" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Edited}" IsVisible="{Binding IsPresent}"
                                               FontSize="11.5" Foreground="{StaticResource T2Brush}" />
                                    <TextBlock Text="Folder not found" IsVisible="{Binding IsMissing}"
                                               FontSize="11.5" Foreground="{StaticResource DangerBrush}" />
                                </Panel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="0,0,14,0"
                                            IsVisible="{Binding IsMissing}" VerticalAlignment="Center">
                                    <Button Classes="open" Theme="{StaticResource BareButton}" Content="Locate"
                                            Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).LocateProjectCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="open" Theme="{StaticResource BareButton}" Content="Remove"
                                            Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).RemoveProjectCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <Button Grid.Column="3" Classes="open" Theme="{StaticResource BareButton}" Content="Open"
                                                IsVisible="{Binding IsPresent}"
                                                ToolTip.Tip="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).OpenTooltip, FallbackValue={x:Null}}"
                                                ToolTip.ShowOnDisabled="True"
                                                VerticalAlignment="Center" Margin="0,0,14,0"
                                                Command="{Binding $parent[local:ProjectsView].((local:ProjectsViewModel)DataContext).OpenProjectCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}" />
                                <Path Grid.Column="4" Classes="icon fill" Width="10.5" Height="10.5"
                                      IsVisible="{Binding Pinned}" VerticalAlignment="Center"
                                      Data="{StaticResource IconStar}" />
                                <Button Grid.Column="5" Classes="more" Theme="{StaticResource BareButton}" Click="OnMoreClick"
                                        ToolTip.Tip="More" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="..." FontSize="13" FontWeight="Bold" Foreground="{StaticResource T2Brush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Panel>
</UserControl>
