<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ECS3DLauncher.Shared.Models"
             xmlns:controls="using:ECS3DLauncher.Shared.Controls"
             xmlns:local="using:ECS3DLauncher.Tabs.Templates"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dd="using:ECS3DLauncher.Shared"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="720"
             d:DataContext="{x:Static dd:DesignData.Templates}"
             x:Class="ECS3DLauncher.Tabs.Templates.TemplatesView"
             x:DataType="local:TemplatesViewModel">

    <Panel>

        <controls:EmptyState IsVisible="{Binding ShowEmptyState}"
                             IconData="{StaticResource IconLayers}" Heading="{Binding EmptyHeading}"
                             Detail="{Binding EmptyDetail}" />

        <ItemsControl ItemsSource="{Binding VisibleTemplates}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Margin="-9" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:TemplateCard">
                    <Button Theme="{StaticResource BareButton}" Margin="9"
                            Command="{Binding $parent[local:TemplatesView].((local:TemplatesViewModel)DataContext).OpenCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                        <Border Classes="card" Width="236" CornerRadius="11" ClipToBounds="True">
                            <StackPanel>
                                <Panel Height="133" Background="{StaticResource InsetBrush}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           IsVisible="{Binding HasThumbnail}" />
                                    <Panel IsVisible="{Binding !HasThumbnail}">
                                        <Border Background="{StaticResource ThumbStripes}" />
                                        <Border Background="{StaticResource AccDim}" />
                                        <Path Classes="icon" Width="30" Height="30"
                                              Stroke="#2EFFFFFF" StrokeThickness="2.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="{StaticResource IconLayers}" />
                                    </Panel>
                                </Panel>
                                <StackPanel Margin="16,14,16,16" Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                               Foreground="{StaticResource T2Brush}" />
                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="10"
                                                        Background="{StaticResource InsetBrush}"
                                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                               Foreground="{StaticResource T2Brush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border IsVisible="{Binding HasPlayers}" Padding="9,3" CornerRadius="10"
                                            HorizontalAlignment="Left" Background="{StaticResource AccDim}">
                                        <TextBlock Text="{Binding PlayersLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccBrush}" />
                                    </Border>
                                    <TextBlock IsVisible="{Binding NeedsNewerEngine}" Text="Needs a newer engine"
                                               Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource DangerBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Panel>
</UserControl>
