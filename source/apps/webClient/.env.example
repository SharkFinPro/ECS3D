# The authoritative ECS3DServer this client connects to. Mirrors ECS3DClient's --host/--port
# (ClientApp::ConnectOptions defaults: 127.0.0.1 and net::defaultPort). Copy to .env.local to override.
#
# The server must be running its WebSocket transport backend (Transport.cs's Protocol field) - a browser
# cannot open the raw TCP socket the other backend uses.
NEXT_PUBLIC_ECS3D_HOST=127.0.0.1
NEXT_PUBLIC_ECS3D_PORT=3000
